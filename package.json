{
  "name": "dsh-secure-memory",
  "version": "0.1.0",
  "displayName": "Cross-Workspace Memory",
  "description": "DSH 本地加密记忆插件：会话级精确关联、三级记忆检索、上下文预算与原页面状态更新，保留逐工作区授权、来源追溯与提示词注入隔离。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "privacy",
    "cross-workspace",
    "local-first"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/core.test.js test/no-session-creation.test.js test/tool-conflicts.test.js test/v010.test.js test/client-state.test.js",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:v010": "node scripts/benchmark-v010.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
